
[Version]
signature = "$CHICAGO$"
Minimal Windows Cursors by Jo (v1)


[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg    = Scheme.Reg, Wreg


[DestinationDirs]
Scheme.Cur = 10, "%CUR_DIR%"


[Scheme.Reg]
HKCU, "Control Panel\Cursors\Schemes", "%SCHEME_NAME%", , "%10%\%CUR_DIR%\%pointer%, %10%\%CUR_DIR%\%help%, %10%\%CUR_DIR%\%working%, %10%\%CUR_DIR%\%busy%, %10%\%CUR_DIR%\%precision%, %10%\%CUR_DIR%\%text%, %10%\%CUR_DIR%\%pen%, %10%\%CUR_DIR%\%unavailable%, %10%\%CUR_DIR%\%vertical%, %10%\%CUR_DIR%\%horizontal%, %10%\%CUR_DIR%\%diagonal-1%, %10%\%CUR_DIR%\%diagonal-2%, %10%\%CUR_DIR%\%move%, %10%\%CUR_DIR%\%alternate%, %10%\%CUR_DIR%\%link%, %10%\%CUR_DIR%\%person%, %10%\%CUR_DIR%\%pin%"


[Wreg]
HKCU, "Control Panel\Cursors", , 0x00020000, "%SCHEME_NAME%"
HKCU, "Control Panel\Cursors", AppStarting, 0x00020000, "%10%\%CUR_DIR%\%working%"
HKCU, "Control Panel\Cursors", Arrow, 0x00020000, "%10%\%CUR_DIR%\%pointer%"
HKCU, "Control Panel\Cursors", Crosshair, 0x00020000, "%10%\%CUR_DIR%\%precision%"
HKCU, "Control Panel\Cursors", Hand, 0x00020000, "%10%\%CUR_DIR%\%link%"
HKCU, "Control Panel\Cursors", Help, 0x00020000, "%10%\%CUR_DIR%\%help%"
HKCU, "Control Panel\Cursors", IBeam, 0x00020000, "%10%\%CUR_DIR%\%text%"
HKCU, "Control Panel\Cursors", No, 0x00020000, "%10%\%CUR_DIR%\%unavailable%"
HKCU, "Control Panel\Cursors", NWPen, 0x00020000, "%10%\%CUR_DIR%\%pen%"
HKCU, "Control Panel\Cursors", Person, 0x00020000, "%10%\%CUR_DIR%\%person%"
HKCU, "Control Panel\Cursors", Pin, 0x00020000, "%10%\%CUR_DIR%\%pin%"
HKCU, "Control Panel\Cursors", SizeAll, 0x00020000, "%10%\%CUR_DIR%\%move%"
HKCU, "Control Panel\Cursors", SizeNESW, 0x00020000, "%10%\%CUR_DIR%\%diagonal-2%"
HKCU, "Control Panel\Cursors", SizeNS, 0x00020000, "%10%\%CUR_DIR%\%vertical%"
HKCU, "Control Panel\Cursors", SizeNWSE, 0x00020000, "%10%\%CUR_DIR%\%diagonal-1%"
HKCU, "Control Panel\Cursors", SizeWE, 0x00020000, "%10%\%CUR_DIR%\%horizontal%"
HKCU, "Control Panel\Cursors", UpArrow, 0x00020000, "%10%\%CUR_DIR%\%alternate%"
HKCU, "Control Panel\Cursors", Wait, 0x00020000, "%10%\%CUR_DIR%\%busy%"
HKLM, "SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce\Setup\", "", , "rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"


[Scheme.Cur]
"cursors\alternate.cur"
"cursors\busy.ani"
"cursors\diagonal-1.cur"
"cursors\diagonal-2.cur"
"cursors\help.cur"
"cursors\horizontal.cur"
"cursors\link.cur"
"cursors\move.cur"
"cursors\pen.cur"
"cursors\person.cur"
"cursors\pin.cur"
"cursors\pointer.cur"
"cursors\precision.cur"
"cursors\text.cur"
"cursors\unavailable.cur"
"cursors\vertical.cur"
"cursors\working.ani"


[Strings]
CUR_DIR     	= "Cursors\cursors_by_jo_v1"
SCHEME_NAME 	= "Cursors by Jo (v1)"
alternate	= "cursors\alternate.cur"
busy		= "cursors\busy.ani"
diagonal-1	= "cursors\diagonal-1.cur"
diagonal-2	= "cursors\diagonal-2.cur"
help		= "cursors\help.cur"
horizontal	= "cursors\horizontal.cur"
link		= "cursors\link.cur"
move		= "cursors\move.cur"
pen 		= "cursors\pen.cur"
person      	= "cursors\person.cur"
pin         	= "cursors\pin.cur"
pointer		= "cursors\pointer.cur"
precision	= "cursors\precision.cur"
text		= "cursors\text.cur"
unavailable	= "cursors\unavailable.cur"
vertical	= "cursors\vertical.cur"   
working		= "cursors\working.ani"
